parameters:
    level: 5
    paths:
        - src
        - public
        - bin
        - dev/mock-routeros
        - dev/geoip
        - tests
    excludePaths:
        - vendor
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    # Values come from the environment at runtime – don't treat the analysis-time value as fixed.
    dynamicConstantNames:
        - APP_ENV
        - APP_NAME
        - APP_TIMEZONE
        - APP_VERSION
        - DATA_DIR
        - DB_PATH
        - DB_DSN
        - RESET_LOGIN_FILE
        - MIKROTIK_BASE_URL
        - MIKROTIK_USERNAME
        - MIKROTIK_PASSWORD
        - MIKROTIK_CERT_FINGERPRINT
        - MIKROTIK_CONNECT_TIMEOUT
        - MIKROTIK_TIMEOUT
        - ADDRESS_LIST_PREFIX
        - MAX_DEFAULT_DURATION
        - MAX_EXTENDED_DURATION
        - MAX_ACCESS_LEVEL
        - WIREGUARD_INTERFACE
        - LOGIN_IP_WHITELIST
        - TRUSTED_PROXIES
        - DEV_DEFAULT_IP
        - SETUP_TOKEN
        - SESSION_LIFETIME
        - MAX_LOGIN_ATTEMPTS_PER_HOUR
        - LOGIN_ATTEMPT_TTL
        - MAX_AUDIT_LOG_ENTRIES
        - OTP_STEP
        - OTP_DIGITS
        - OTP_ISSUER
        - GREETING_MESSAGES
        - LOGIN_HERO_IMAGES
        - APP_BASE_URL
        - MONITOR_ENABLED
        - MONITOR_TOKEN
        - MONITOR_ALLOWED_SOURCES
        - MONITOR_INTERVAL
        - MONITOR_ALLOWED_COUNTRIES
        - MONITOR_LEARNING_DAYS
        - MONITOR_TRAVEL_WINDOW
        - MONITOR_FAILED_LOGINS
        - MONITOR_FAILED_LOGINS_WINDOW
        - MONITOR_BUNDLE_WINDOW
        - MONITOR_COOLDOWN
        - MONITOR_DIGEST_TIME
        - MONITOR_NOTIFY_USERS
        - MONITOR_HOSTING_ASNS
        - MONITOR_IP_RETENTION_DAYS
        - MONITOR_ALERT_RETENTION_DAYS
        - MONITOR_PSEUDONYM_KEY
        - GEOIP_COUNTRY_DB
        - GEOIP_ASN_DB
        - GEOIP_AUTO_UPDATE
        - MAIL_TRANSPORT
        - SMTP_HOST
        - SMTP_PORT
        - SMTP_SECURITY
        - SMTP_USERNAME
        - SMTP_PASSWORD
        - SMTP_TIMEOUT
        - MAIL_FROM
        - MAIL_FROM_NAME
        - ALERT_ADMIN_EMAILS
        - MONITOR_AI
        - OPENROUTER_API_KEY
        - OPENROUTER_BASE_URL
        - OPENROUTER_MODEL
        - OPENROUTER_PROVIDERS
        - OPENROUTER_MAX_PRICE_PROMPT
        - OPENROUTER_MAX_PRICE_COMPLETION
        - OPENROUTER_REASONING_EFFORT
        - MONITOR_AI_MAX_CALLS_PER_DAY
        - MONITOR_AI_TIMEOUT
        - APP_ROOT
